        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <customObject id="Voe-Tx-rLC" userLabel="AppDelegate" customClass="AppDelegate" customModule="FastPlay" customModuleProvider="target"/>
        <menu title="Main Menu" systemMenu="main" id="29">
            <items>
                <!-- FastPlay Menu -->
                <menuItem title="FastPlay" id="56">
                    <menu key="submenu" title="FastPlay" systemMenu="apple" id="57">
